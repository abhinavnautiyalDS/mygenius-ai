[Unit]
Description=AgenticDesk FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agenticdesk/agenticdesk/backend
EnvironmentFile=/home/ubuntu/agenticdesk/agenticdesk/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/agenticdesk/agenticdesk/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
